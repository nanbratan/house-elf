{
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 100,
	"trailingComma": "none",
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./apps/web/src/routes/layout.css",
	"overrides": [
		{
			"files": "*.svelte",
			"options": { "parser": "svelte" }
		},
		{
			"comment": "prettier-plugin-tailwindcss resolves the theme from one stylesheet to sort classes. The two apps have different token sets, so each needs its own or the React app's classes sort against tokens it does not have.",
			"files": "apps/web-react/**",
			"options": { "tailwindStylesheet": "./apps/web-react/src/styles/app.css" }
		}
	]
}
