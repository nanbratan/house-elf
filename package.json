{
	"name": "house-elf",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"check": "tsc --noEmit -p tsconfig.json && bun run --filter '*' check",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun run --filter '*' test",
		"test:unit": "bun run --filter '*' test:unit",
		"test:watch": "bun run --filter '*' test:watch",
		"test:e2e": "playwright test",
		"build": "bun run --filter '*' build",
		"verify": "bun run check && bun run lint && bun run format:check && bun run test && bun run build",
		"db:up": "docker compose -f infra/docker-compose.yml up -d",
		"db:down": "docker compose -f infra/docker-compose.yml down"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	}
}
