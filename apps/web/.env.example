# Copy to .env and adjust. .env is git-ignored; this file is not.
#
# Scope: only what the SvelteKit app itself reads. It is a thin proxy to the
# Mastra server, so it must never hold the database URL or the provider key —
# those live in the repo-root .env and are read by the Mastra server alone.

# Origin of the Mastra server. A bare origin with no path: the chat route is
# mounted at /chat/:agentId, not under /api (which is Mastra's own built-in API).
# Server-only — it is deliberately not PUBLIC_, so it never reaches the browser.
MASTRA_URL=http://localhost:4111
