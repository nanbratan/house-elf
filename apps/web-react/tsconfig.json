{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"~/*": ["./src/*"],
			"@/registry/default/ui/*": ["./src/lib/components/vendor/ai-elements/ui/*"],
			"@/lib/utils": ["./src/lib/utils/cn.ts"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "vite.config.ts"],
	"exclude": ["src/lib/components/vendor"]
}
