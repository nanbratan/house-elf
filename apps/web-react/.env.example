# Copy to .env (git-ignored). Only what this app reads: it is a thin proxy, so
# the database URL and provider key stay in the repo-root .env, read by the
# Mastra server alone.

# A bare origin, no path: the chat route is mounted at /chat/:agentId, not under
# /api (Mastra's own built-in API). Read via process.env, never an env import,
# so it cannot reach the browser.
MASTRA_URL=http://localhost:4111
