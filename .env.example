# Copy to .env and fill in. .env is git-ignored; this file is not.
# Keep this file current — every variable the app reads should appear here.

# --- Postgres -----------------------------------------------------------------
# Dev database. Matches infra/docker-compose.yml (service: postgres, port 5432).
DATABASE_URL=postgresql://houseelf:houseelf@localhost:5432/houseelf

# Integration-test database. Matches infra/docker-compose.yml
# (service: postgres-test, port 5433). Data is tmpfs-backed and disposable.
TEST_DATABASE_URL=postgresql://houseelf:houseelf@localhost:5433/houseelf_test

# --- Model provider -----------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Models -------------------------------------------------------------------
# Model router IDs, "provider/model". Never hardcode these in source.
# Valid IDs: bun .agents/skills/mastra/scripts/provider-registry.mjs --provider anthropic
AGENT_GENERAL_MODEL=anthropic/claude-haiku-4-5
